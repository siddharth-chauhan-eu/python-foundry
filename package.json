{
  "name": "python-learning-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Repository documentation quality tools",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write \"**/*.md\" \".github/**/*.yml\" \"package.json\" \".prettierrc.json\" \".markdownlint.json\"",
    "format:check": "prettier --check \"**/*.md\" \".github/**/*.yml\" \"package.json\" \".prettierrc.json\" \".markdownlint.json\"",
    "lint:md": "markdownlint --config .markdownlint.json --ignore-path .gitignore \"**/*.md\"",
    "check": "npm run format:check && npm run lint:md",
    "verify": "npm run check && npm audit && uv lock --check && uv sync --locked && uv run --locked python scripts/verify.py && git diff --check && git diff --cached --check"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "markdownlint-cli": "0.49.1"
  },
  "overrides": {
    "js-yaml": "5.4.1",
    "smol-toml": "1.9.1",
    "katex": "0.18.2"
  }
}
